{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/firewall.sh"
                    },
                    {
                        "type": "command",
                        "command": ".claude/hooks/compact.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/post-lint.sh"
                    }
                ]
            }
        ]
    }
}
